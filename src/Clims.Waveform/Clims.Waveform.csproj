<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Overview waveform (peaks) of LMS tracks: downloads the file, decodes FLAC, MP3, Ogg Vorbis and WAV, caches the result.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BunLabs.NAudio.Flac" Version="2.0.1" />
    <PackageReference Include="NLayer" Version="3.0.1" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clims.Lms\Clims.Lms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Clims.Waveform.Tests" />
  </ItemGroup>

</Project>
